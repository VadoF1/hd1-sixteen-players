{
  "obsidian": 1,
  "id": "vado.sixteen-players",
  "version": "0.7.6",
  "name": {
    "en": "16 Players (Highest Priority)"
  },
  "description": {
    "en": "Up to 16 players in one game, with enemies scaled to the player count. Early test build: every player in the lobby needs this mod, the same version and the same camera option. Must be placed at bottom of mod list, at the highest priority"
  },
  "source": "https://github.com/VadoF1/hd1-sixteen-players",
  "scope": "session",
  "entry": "main.lua",
  "options": [
    {
      "id": "camera",
      "type": "choice",
      "default": "free",
      "choices": [
        {
          "id": "free",
          "label": {
            "en": "Free (Recommended): each machine follows its own players"
          }
        },
        {
          "id": "shared",
          "label": {
            "en": "Shared (vanilla-esque): one view follows everyone"
          }
        }
      ],
      "label": {
        "en": "Camera"
      },
      "description": {
        "en": "Everyone in the lobby must pick the same camera."
      }
    }
  ],
  "resources": [
    {
      "type": "network_config",
      "name": "#0b2f08fe66e395c0",
